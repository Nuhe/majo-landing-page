        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.first().json.body ?? {};\nconst clean = (value, max) => typeof value === 'string'\n  ? value.trim().replace(/[\\r\\n\\t]+/g, ' ').slice(0, max)\n  : '';\nconst nombre = clean(raw.nombre, 120);\nconst email = clean(raw.email, 254).toLowerCase();\nconst telefono = clean(raw.telefono, 30);\nconst modalidad = clean(raw.modalidad, 20);\nconst website = clean(raw.website, 120);\nconst digits = (telefono.match(/\\d/g) ?? []).length;\nconst valid = website === '' && nombre.length >= 2\n  && /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email)\n  && digits >= 8 && digits <= 20\n  && ['Presencial', 'Virtual'].includes(modalidad)\n  && raw.consentimiento === true;\nreturn [{ json: { valid, nombre, email, telefono, modalidad, recibido: new Date().toISOString() } }];"
      },
      "id": "af13fcb9-e3ba-4948-b906-f3baa02ef0c1",
